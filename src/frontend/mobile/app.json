{
  "expo": {
    "name": "Clinic Scribe",
    "slug": "ai-medical-transcription-mobile",
    "scheme": "aimedicaltranscription",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.motorchain.aimedicaltranscription",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Clinic Scribe accesses the microphone only to record after you confirm the patient, active encounter, and recording consent."
      }
    },
    "android": {
      "package": "com.motorchain.aimedicaltranscription",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "efdcfaf7-9884-44da-9378-36ebf68429a3"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Clinic Scribe to use the microphone only for a consented recording in the confirmed patient encounter.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ]
  }
}
